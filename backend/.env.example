PORT=5000
NODE_ENV=development

# mongodb+srv://<user>:<password>@<cluster>/splitta?retryWrites=true&w=majority
MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=30d

CLIENT_URL=http://localhost:3000

# Web Push (VAPID). Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Reading items out of a receipt photo. Without this the scan button simply
# does not appear and everything else works as before.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Whole-server ceiling on scans per day, as a cost backstop. Default 300.
SCAN_DAILY_LIMIT=300
