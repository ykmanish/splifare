{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/lists/layout,_N_T_/(app)/lists/page,_N_T_/lists"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/lists/__PAGE__",
    "/!KGFwcCk/lists",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}