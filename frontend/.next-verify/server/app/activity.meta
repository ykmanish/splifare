{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/activity/layout,_N_T_/(app)/activity/page,_N_T_/activity"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/activity/__PAGE__",
    "/!KGFwcCk/activity",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}