    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/friends/layout,_N_T_/(app)/friends/page,_N_T_/friends"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/friends/__PAGE__",
    "/!KGFwcCk/friends",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}